#  5th Jun 2021  eweb     #0008 update after inactivity
#  8th Oct 2021  eweb     #0008 get latest bundler & launch instaweb
#  8th Dec 2021  eweb     #0008 don't launch instaweb if already running
#  5th Apr 2023  eweb     #0008 accounts switch to main
# 21st Apr 2023  eweb     #0008 handle upstream remotes
# 21st Jun 2023  eweb     #0008 fetching and rebasing
# 19th Jan 2025  eweb     #0008 disambiguate between branches and origins
# 22nd May 2025  eweb     #0008 update and upgrade brew
# 23rd Nov 2025  eweb     #0008 bundle install less noise
# 28th Nov 2025  eweb     #0008 update RubyMotion repos
# 12th May 2026  eweb     #0008 verify ruby version
# 21st Jul 2026  eweb     #0008 use mise directly
#

# bash needed echo -e "..."

RUBY_VERSION=4.0.6

running=$(ruby -e "print RUBY_VERSION")

if [[ $running != $RUBY_VERSION ]] ; then
  echo -en "\033[31m"
  echo -en "Wrong Ruby, have $running need $RUBY_VERSION\n"
  echo -en "\033[0m"
  exit 1
fi

echo "\033[36mbrew\033[0m"
brew update
brew upgrade --no-ask

# echo "\033[36masdf plugin update\033[0m"
# asdf plugin update --all

echo "\033[36mmise\033[0m"
mise upgrade

(cd ~/bin
 echo "\033[36mbundler\033[0m"
 # gem update rubygems
 gem update --system
 # rvm @global do gem update rubygems
 gem install bundler
 # bundle update --bundler
)

for dir in ~/bin ~/accounts/main
do
  echo "\033[32m$dir\033[0m" &&
  cd "$dir" &&
  test -d .git &&
  git fetch --all &&
  git pull &&
  test -f Gemfile &&
  bundle install --quiet
done

for dir in ~/projects/*
do
  test -d "$dir" &&
  echo "\033[32m$dir\033[0m" &&
  cd "$dir" &&
  test -d .git &&
  if [[ -d .git/refs/remotes ]]; then
    git fetch --all &&
    git pull -p
  fi
  if [[ -f .git/refs/remotes/upstream/main ]]; then
    git checkout main
    git fetch upstream main:upstream
    git rebase --autostash heads/upstream
    # git push --force
  fi
  if [[ -f .git/refs/remotes/upstream/master ]]; then
    git checkout master
    git fetch upstream master:upstream
    git rebase --autostash heads/upstream
    # git push --force
  fi
done

for dir in ~/projects/acc/*/
do
  echo "\033[32m$dir\033[0m" &&
  cd "$dir" &&
  test -f Gemfile &&
  bundle install --quiet
done

for qdir in ~/projects/qstream ~/projects/quest ~/projects/amirrajan
do
  test -d $qdir &&
  for dir in $qdir/*
  do
    if [ "$dir:t" = "llvm" ]; then
        continue
    fi
    test -d "$dir" &&
    echo "\033[32m$dir\033[0m" &&
    cd "$dir" &&
    test -d .git &&
    git fetch --all &&
    git pull -p
  done
done

(lsof -i :1234 || git -C ~/projects/acc instaweb --start)
