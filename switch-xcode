#

# to set up to run without password
# `sudo EDITOR=vim visudo`
# and add
# `<username> ALL=(ALL) NOPASSWD: /path/to/xcode-select`
# e.g.
# `eweb ALL=(ALL) NOPASSWD: /usr/bin/xcode-select`

xcver="-$1"
if [ "$xcver" == "--" ]
then
  xcver=""
fi


if [ "$xcver" != "-" ]
then
  xcode="/Applications/Xcode${xcver}.app/Contents/Developer"

  if [[ `xcode-select -p` == $xcode ]]; then
    :
  elif [[ -d $xcode ]] ; then
    sudo xcode-select -s $xcode
  else
    echo "xcode $xcode not found"
  fi
fi

xcode-select -p
